# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Authentication
JWT_SECRET="replace-with-32-character-random-secret-key"

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Storage (S3-compatible API: MinIO dev, Cloudflare R2 prod)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="cpms-resumes"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# Mail (Mailpit dev, Brevo prod)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="cpms@college.example"
