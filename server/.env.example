# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://cpms:cpmspassword@localhost:5432/cpms?schema=public&connection_limit=20"
DIRECT_URL="postgresql://cpms:cpmspassword@localhost:5432/cpms?schema=public"

# Authentication
JWT_SECRET="super-secret-jwt-key-with-at-least-32-chars-long"

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Storage (S3-compatible API: MinIO dev, Cloudflare R2 prod)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="cpms-resumes"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# Mail (Mailpit dev, Brevo prod)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="cpms@college.example"

